DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@localhost:5432/labinventory
INFLUX_URL=http://localhost:8181
INFLUX_TOKEN=your_influx_token
INFLUX_DB=labinventory
IMAGE_DIR=/app/images

# DigiKey API (for component lookup + images)
DIGIKEY_CLIENT_ID=your_client_id
DIGIKEY_CLIENT_SECRET=your_client_secret
DIGIKEY_TOKEN=your_access_token

# Mouser API (for component lookup + images)
MOUSER_API_KEY=your_mouser_key

# Brave Search API (1000 queries/month, 50/sec max)
BRAVE_API_KEY=your_brave_key

# Tavily AI Search API (1000 queries/month)
TAVILY_API_KEY=your_tavily_key

# SerpAPI (Google Images proxy, 100/month free)
SERPAPI_KEY=your_serpapi_key

# Gemini (AI parsing for add component)
GEMINI_API_KEY=your_gemini_key
GEMINI_PROJECT_ID=gen-lang-client-0425003962
